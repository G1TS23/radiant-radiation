#!/bin/sh
# Refuse un message de commit qui ne respecte pas Conventional Commits.
# À copier dans .githooks/commit-msg (chmod +x).

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Laisse passer les merges, reverts et fixups générés par git.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._,-]+\))?!?: .{1,72}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit refusé : le message doit suivre Conventional Commits." >&2
  echo "  type(scope): description   (72 caractères max)" >&2
  echo "  types : feat fix docs style refactor perf test build ci chore revert" >&2
  echo "Reçu : $first_line" >&2
  exit 1
fi
